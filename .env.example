# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# --- Tesseract OCR ---
# Path to Tesseract binary (only needed on Windows)
# Linux/macOS: auto-detected, leave blank
# Windows: set to full path, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Poppler ---
# Path to Poppler binaries (only needed on Windows)
# Windows: e.g. C:\poppler\bin
# Linux/macOS: auto-detected
POPPLER_PATH=

# --- HuggingFace ---
# Optional: HuggingFace token for private models or to avoid rate limits
# Get from: https://huggingface.co/settings/tokens
# Leave blank for public models (no auth needed)
HUGGINGFACE_TOKEN=

# --- Model Paths (override defaults in pipeline_config.yaml) ---
# NER_MODEL_PATH=models/ner
# CLASSIFIER_MODEL_PATH=models/classifier

# --- App Config ---
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO
