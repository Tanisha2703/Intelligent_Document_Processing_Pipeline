# Copy to .env and fill in. Nothing here is required for the recorded-examples demo or the tests.

# --- Live model (the fine-tuned receipt and form models run on Modal) ---
# Name of the deployed Modal app (modal deploy benchmarks/modal_run.py)
DOCINTEL_VLM_APP=
# Modal credentials, if not already in ~/.modal.toml
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Spend cap enforced by every Modal script, in USD (see benchmarks/modal_common.py)
# DOCINTEL_BUDGET_USD=15

# --- Document-type routing (POST /document) ---
# Set to 1 to load the DiT classifier on CPU; needs requirements-doctype.txt (torch + transformers)
# DOCINTEL_DOCTYPE=1

# --- Review threshold ---
# Calibrated probability a field needs to be auto-accepted. Default 0.80 (87% accepted, 96.3% precision on the SROIE
# test split); 0.95 is the strict setting (58 to 59% accepted, 99.2% precision). See docs/RESULTS.md section 2.3.
# DOCINTEL_ACCEPT_THRESHOLD=0.80

# --- Service protection (see docs/DEPLOYMENT.md section 6) ---
# Without a key the API only answers the local machine. Set one before exposing it anywhere.
# DOCINTEL_API_KEY=
# DOCINTEL_MAX_GPU_CALLS_PER_DAY=200
# DOCINTEL_MAX_CONTAINERS=3
# Password for the Streamlit live-upload tab
# DOCINTEL_DEMO_PASSWORD=

# --- Service ---
LOG_LEVEL=INFO
